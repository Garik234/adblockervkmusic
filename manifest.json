{
  "manifest_version": 3,
  "name": "VK Music Ad Blocker",
  "version": "1.0.0",
  "description": "Блокирует аудио-рекламу, баннеры и промо-блоки VK Музыки на vk.com и vk.ru.",

  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting"
  ],

  "host_permissions": [
    "*://*.vk.com/*",
    "*://*.vk.ru/*",
    "*://*.userapi.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.vk.com/*",
        "*://*.vk.ru/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "vk_ad_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "VK Music Ad Blocker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "vk-music-adblocker@local",
      "strict_min_version": "115.0"
    }
  }
}
